generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Factory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skus   SKU[]
  scores ManufacturingScore[]

  @@map("factories")
}

model SKU {
  id        Int      @id @default(autoincrement())
  factoryId Int
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory                 @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  scores  ManufacturingScoreSKU[]

  @@unique([factoryId, code])
  @@map("skus")
}

model ManufacturingScore {
  id        Int      @id @default(autoincrement())
  factoryId Int
  month     Int
  year      Int
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory   Factory                 @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  skuScores ManufacturingScoreSKU[]

  @@unique([factoryId, month, year])
  @@map("manufacturing_scores")
}

model ManufacturingScoreSKU {
  id                   Int      @id @default(autoincrement())
  manufacturingScoreId Int
  skuId                Int
  score                Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  manufacturingScore ManufacturingScore @relation(fields: [manufacturingScoreId], references: [id], onDelete: Cascade)

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([manufacturingScoreId, skuId])
  @@map("manufacturing_score_skus")
}

model KPI {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  unit        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  annualMetrics KPIAnnualMetric[]
  actuals       KPIActual[]

  @@map("kpis")
}

model KPIAnnualMetric {
  id        Int      @id @default(autoincrement())
  kpiId     Int
  year      Int
  actual    Decimal? @db.Decimal(14, 4)
  target    Decimal? @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, year])
  @@index([year])
  @@map("kpi_annual_metrics")
}

model KPIActual {
  id        Int      @id @default(autoincrement())
  kpiId     Int
  year      Int
  month     Int
  value     Decimal? @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, year, month])
  @@index([year, month])
  @@map("kpi_actuals")
}
